			"**/projects/**": true
		},

		// ── Terminal ────────────────────────────────────────
		"terminal.integrated.defaultProfile.windows": "PowerShell",
		"terminal.integrated.cwd": "C:\\Users\\1028120\\Documents\\Dev\\.dev-knowledge",

		// ── Explorer ────────────────────────────────────────
		// Per ADR-59 universal visual pattern (with 2026-05-27 sort-regression amendment).
		// "upper" groups ALL-CAPS canonical .md ahead of lowercase configs (visual pattern).
		// "sortOrderReverse: true" gives newest-first inside dated folders (audits/,
		// handoffs/, decisions/transcripts/) — operator's restored preference. The prior
		// session's claim that sortOrderReverse "is not a real VS Code setting" was
		// empirically wrong: PR microsoft/vscode#149952 merged 2024-07-30 (insiders-
		// released, verified). Re-verified 2026-05-27 against vscode source + release.
		//
		// ROOT-CONTRACT v1 C4: the first TWO keys below are the contract-bound pair -- they
		// ARE _WORKSPACE_REQUIRED_SETTINGS, and a wrong or absent value is a WARN from
		// check_workspace_settings. `explorer.sortOrderReverse` is NOT in that set, so it is
		// a hub practice rather than a fleet-asserted clause; the 2026-08-31 amendment names
		// that gap and deliberately leaves it open rather than over-claiming "same ordering".
		"explorer.sortOrder": "default",
		"explorer.sortOrderLexicographicOptions": "upper",
		"explorer.sortOrderReverse": true,
		"explorer.compactFolders": false,

		// ── Todo Tree ───────────────────────────────────────
		// Track TODOs, triggers, and review markers across knowledge files
		"todo-tree.general.tags": [
			"TODO",
			"TRIGGER",
			"REVIEW",
			"PENDING",
			"DEPRECATED"
		],
		"todo-tree.highlights.customHighlight": {
			"TRIGGER": {
				"icon": "alert",
				"foreground": "#FF8C00"
			},
			"REVIEW": {
				"icon": "eye",
				"foreground": "#6495ED"
			}
		},

		// ── Misc ────────────────────────────────────────────
		"workbench.editor.highlightModifiedTabs": true,
		"workbench.startupEditor": "none",
		"breadcrumbs.enabled": true
