				"args": [
					"-NoProfile",
					"-Command",
					"Get-ChildItem '${workspaceFolder:📓 .dev-knowledge}/docs/handoffs' -Recurse -Filter 'HANDOFF.md' | Sort-Object Directory -Descending | Select-Object -First 1 | ForEach-Object { code -r $_.FullName }"
				],
				"presentation": { "reveal": "silent", "panel": "dedicated", "close": true },
				"problemMatcher": []
			},
			{
