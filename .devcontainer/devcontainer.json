// .devcontainer/devcontainer.json — [#554] NB4-G stage 1: the off-machine lane substrate.
//
// WHY THIS EXISTS: a lane that runs off this workstation must run on a *provisioned* host.
// The measured failure shape is not "the container won't build" — it is a container that
// builds fine and then runs gates that are silently vacuous: the wrong `uv`, a shallow clone
// (every history-dependent detector reads as clean), or unarmed git hooks. Intake #39 §D and
// [#554]'s four legs name those traps; `provision.sh` ASSERTS each one closed and REFUSES
// rather than logging.
//
// SINGLE SOURCE OF PINS: this file declares no version it does not have to. `devcontainer.json`
// is static JSON and cannot read a file, so every pin that has a home in the repo is read at
// provision time by `provision.sh` from that home, never restated here:
//   * uv version   <- pyproject.toml [tool.uv] required-version   (ADR-106: `==0.11.19`)
//   * interpreter  <- .python-version                             (`3.12.10`, installed BY uv)
//   * deps         <- uv.lock via `uv sync --locked`
// The base-image tag below is the ONE version token this file carries, and it is a floor, not
// the pin: uv installs the exact `.python-version` interpreter for the project venv and
// `provision.sh` asserts the result, so the image's own Python never decides what the gates run
// on. Bumping `.python-version` therefore needs no edit here.
//
// PORTABILITY (row Done-when clause 2): nothing below is Codespaces-specific. The identical
// pair of files runs on a VPS via `devcontainer up --workspace-folder .` — that is the whole
// point of using the devcontainer spec rather than a Codespaces-only setup script.
{
  "name": "dev-knowledge — lane substrate (NB4-G stage 1)",

  // Debian-based devcontainer image with git + a system Python floor. The `1-3.12-bookworm`
  // tag tracks the 3.12 line, matching pyproject's `requires-python = ">=3.12"`; the EXACT
  // interpreter is provisioned by uv from `.python-version`. The tag itself is unchanged and
  // still the ONE version token this file carries — it moved into `Dockerfile`'s `BASE_IMAGE`
  // arg, which is built here instead of used directly because that image's apt is broken
  // upstream (unsigned yarn repo). `Dockerfile` carries the full measurement; without it no SSH
  // server can be installed in the container and no feature can build.
  "build": {
    "dockerfile": "Dockerfile"
  },

  // THE REACHABILITY LEG — witnessed, not anticipated. The image above carries no
  // openssh-server, and Codespaces injects one only when the devcontainer asks for it. Without
  // this feature `gh codespace ssh` AND `gh codespace logs` both refuse with "failed to start
  // SSH server", which means a codespace built from this file comes up perfectly and is then
  // reachable ONLY from a browser — no CLI, no agent, no way to read the provisioning log that
  // proves the four legs closed. An off-machine LANE substrate that no lane can be driven on is
  // not a substrate, so this belongs with the four legs rather than in the customizations block.
  // Costs nothing off-Codespaces: `devcontainer up` on a VPS installs the same sshd and the
  // identical-script clause is preserved.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  // THE ENV GATE ([#554] leg 4) IS NOT DECLARED HERE, AND THE ABSENCE IS THE FIX.
  //
  // This file previously carried
  //   "containerEnv": { "DEV_KNOWLEDGE_PROVISION_STAMP": "${containerEnv:HOME}/..." }
  // on the reasoning that a VPS host might want to relocate the stamp. Measured on
  // 2026-08-19 (`docs/audits/2026-08-19-technical-554-proof.md` §2.1): `containerEnv` cannot
  // reference `containerEnv` — a variable cannot reference the block being defined — so the
  // literal string `${containerEnv:HOME}/.dev-knowledge-provision-stamp` reached
  // `provision.sh`, whose `mkdir -p "$(dirname ...)"` then created a directory *named*
  // `${containerEnv:HOME}` inside the working tree on every single container start.
  //
  // The relocation capability is NOT lost: `provision.sh` still honours an exported
  // `DEV_KNOWLEDGE_PROVISION_STAMP` and falls back to `${HOME}/.dev-knowledge-provision-stamp`,
  // which is what the comment above always claimed the value was. A VPS host that genuinely
  // wants it elsewhere exports the variable; a host that does not says nothing and gets a
  // stamp in `$HOME` rather than a junk directory in the repo. The script additionally
  // REFUSES a stamp path that still carries an unexpanded `${`, so this whole class fails
  // loudly at the next host that tries it instead of being rediscovered by measurement.

  // THE PREBUILD LEG (lane contract A3), in the only form a repo file can carry it.
  //
  // A Codespaces prebuild executes `onCreateCommand` and `updateContentCommand` and bakes their
  // result into the prebuilt image; `postCreateCommand` is NEVER prebuilt — it runs at codespace
  // creation, every time. So with provisioning wired only to `postCreateCommand`, enabling a
  // prebuild would cache the ~85 s container build and leave the whole provisioning run on the
  // create path. Naming the same script here moves it inside the cacheable half.
  //
  // Running it twice on a NON-prebuilt create is deliberate and costs almost nothing: C1 makes
  // the script idempotent, and a fully-provisioned re-run measured **7 s** in a live container
  // on 2026-08-21 (against ~28 s for the cold run it follows). Paying 7 s on every cold create to
  // save ~28 s on every prebuilt one is the trade, and it is stated here rather than assumed.
  //
  // The three prebuild SETTINGS the contract names — trigger "on configuration change", region
  // EuropeWest, template history 1 — are NOT expressible in this file. They are server-side
  // operator UI state with no public API (probed 2026-08-21: REST 404, GraphQL introspection
  // empty, no `gh codespace` subcommand). They are declared in `.devcontainer/provisioning.yaml`
  // and `scripts/cloud_provisioning.py prebuild` reports declaration-vs-live drift.
  "onCreateCommand": "bash .devcontainer/provision.sh",

  // Provision once per container creation: install pinned uv, unshallow, sync, arm hooks,
  // assert all four legs, run the gate-liveness smoke, then stamp. Kept alongside
  // `onCreateCommand` above rather than replaced by it: a prebuilt image is built from the
  // DEFAULT branch, so a codespace created later — or from a different branch — can carry pins
  // the prebuild never saw. This is the run that re-asserts against the tree actually checked out.
  "postCreateCommand": "bash .devcontainer/provision.sh",

  // Re-assert on EVERY start. A container resumed from a stale image, or one whose repo has
  // since moved its uv pin, is half-provisioned — and this refuses it instead of handing a
  // lane an environment whose gates do not execute.
  "postStartCommand": "bash .devcontainer/provision.sh --gate",

  // Do not report the container ready — or attach a session to it — until provisioning has
  // actually finished. Without this the window between "container up" and "hooks armed" is
  // exactly the arming race this row exists to close.
  "waitFor": "postStartCommand",

  // Codespaces free tier is a 2-core / 8 GB machine; declaring the floor keeps a lane from
  // being scheduled somewhere that cannot run the suite. Storage is deliberately NOT declared:
  // raising it forces a larger (billable) machine type, and stage 1 is a €0 build.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
