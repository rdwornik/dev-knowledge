"end_early" [label="END-EARLY\nNO CODE  [HOLE]", shape=ellipse, style="filled,dashed", fillcolor="#fff59d", color=red, penwidth=3, peripheries=2, fontcolor=red, fontsize=10]
"launch_window" [shape=point, width=0.01, label=""];
"start" -> "t_schedule" [label=""];
"t_schedule" -> "t_parse" [label=""];
"t_parse" -> "g_agree" [label=""];
"g_agree" -> "t_valid" [label="agree\n[parse['ok']]"];
"g_agree" -> "end_refused" [label="disagree"];
"t_valid" -> "g_valid" [label=""];
"g_valid" -> "t_tier" [label="valid\n[valid['ok']]"];
"g_valid" -> "end_refused" [label="invalid"];
"t_tier" -> "t_claim" [label=""];
"t_claim" -> "g_claim" [label=""];
"g_claim" -> "t_dep" [label="won\n[claim['ok']]"];
"g_claim" -> "end_refused" [label="refused (exit 3)"];
"t_dep" -> "g_dep" [label=""];
"g_dep" -> "t_serial" [label="READY\n[dep['status'] == 'READY']"];
"g_dep" -> "end_refused" [label="BLOCKED-FAILED\n[dep['status'] == 'BLOCKED-FAILED']"];
"g_dep" -> "end_hold" [label="WAITING"];
"t_serial" -> "g_serial" [label=""];
"g_serial" -> "t_substrate" [label="clear\n[serial['clear']]"];
"g_serial" -> "end_hold" [label="member live"];
"t_substrate" -> "g_substrate" [label=""];
"g_substrate" -> "t_capram" [label="local\n[substrate['substrate'] == 'local']"];
"g_substrate" -> "t_route" [label="codespace\n[substrate['substrate'] == 'codespace']"];
"g_substrate" -> "end_refused" [label="cloud (no code)"];
"t_route" -> "end_routed_codespace" [label=""];
"t_capram" -> "g_capram" [label=""];
"g_capram" -> "t_prelaunch" [label="FIRE\n[capram['action'] == 'FIRE']"];
"g_capram" -> "end_hold" [label="HOLD"];
"t_prelaunch" -> "g_prelaunch" [label=""];
"g_prelaunch" -> "t_held" [label="cleared\n[prelaunch['passed']]"];
"g_prelaunch" -> "end_refused" [label="refused"];
"t_held" -> "g_held" [label=""];
"g_held" -> "end_already_launched" [label="held\n[bool(held['held'])]"];
"g_held" -> "end_refused" [label="listing unreadable\n[bool(held.get('unreadable'))]"];
"g_held" -> "t_spawn" [label="free", lhead=cluster_launch_window];
"t_spawn" -> "g_spawn" [label=""];
"g_spawn" -> "t_identify" [label="started\n[spawn['returncode'] == 0]"];
"g_spawn" -> "w_err_spawn" [label="exit != 0"];
"t_identify" -> "g_identify" [label=""];
"g_identify" -> "t_receipt" [label="identified\n[bool(identify['job_id'])]"];
"g_identify" -> "w_err_unresolved" [label="unresolved"];
"t_receipt" -> "eg_running" [label="", ltail=cluster_launch_window];
"b_spawn_failed" -> "end_refused" [label="", style=dashed];
"b_unresolved" -> "end_unresolved" [label="", style=dashed];
"eg_running" -> "c_handback" [label=""];
"eg_running" -> "c_reaped" [label=""];
"eg_running" -> "c_early" [label=""];
"c_handback" -> "end_launched" [label=""];
"c_reaped" -> "end_reaped" [label=""];
"c_early" -> "end_early" [label=""];
"t_spawn" -> "b_spawn_failed" [style=dotted, arrowhead=none, constraint=false];
"t_identify" -> "b_unresolved" [style=dotted, arrowhead=none, constraint=false];
compound=true; }